{
  "manifestVersion": 2,
  "id": "gh-focus",
  "name": "gh Focus",
  "version": "0.1.0",
  "description": "For GitHub repos: the issue, pull request and Actions runs of the workspace you're in, beside your code. Read, comment, review and re-run without leaving the editor for the Tasks page. Uses the gh CLI; not affiliated with GitHub.",
  "author": {
    "name": "chimeyrock999",
    "url": "https://github.com/chimeyrock999"
  },
  "repository": "https://github.com/chimeyrock999/orca-github-plugins",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.256"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "github",
        "title": "gh Focus",
        "icon": "branch",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
